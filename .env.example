# Copy to .env.local for `vercel dev`. In production, set the same vars
# in the Vercel project's Environment Variables UI.

# Postgres (Neon). Same string the official CaseMaster runtime uses; both
# runtimes can talk to the same database concurrently.
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Where the .cms application lives, relative to the project root.
# Defaults to `app/` if unset.
CMS_APP_DIR=app
