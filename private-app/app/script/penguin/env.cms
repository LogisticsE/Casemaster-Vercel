// Single source of truth for the Penguin LMS connection. Mirrors the convention
// of script/axylog/env.cms — credentials live in this file rather than in env
// vars (CaseMaster has no env-var primitive in this build) or in the DB row
// (would require a UI write before first sync). Editing one file + restart is
// enough to flip token / station / endpoint.
//
// On every load() we also upsert the penguin_station row so BOs / pages /
// sync all read consistent values from the DB without each having to call
// load() themselves.

function load()
    set('cfg', <
        ID:             281,
        NAME:           'Pilot station in Gent',
        BASE_URL:       'https://n47k9hi88a.execute-api.eu-central-1.amazonaws.com/prd/api/2024-10',
        BEARER_TOKEN:   'pvObq4Sc44alLJlOkkPBLSdhPAgKDYPJ',
        GRID_COLS:      7,
        GRID_ROWS:      3
    >)

    // Mirror into rd_locker_station (keeps the DB row in sync with env.cms).
    sql.execute(concat(
        'INSERT INTO rd_locker_station (lms_station_id, name, base_url, bearer_token, grid_cols, grid_rows) VALUES (',
        formatString('{0}', pb.get([cfg], 'ID')),         ', ',
        "'", replace(pb.get([cfg], 'NAME'), "'", "''"), "', ",
        "'", pb.get([cfg], 'BASE_URL'),                   "', ",
        "'", pb.get([cfg], 'BEARER_TOKEN'),               "', ",
        formatString('{0}', pb.get([cfg], 'GRID_COLS')),  ', ',
        formatString('{0}', pb.get([cfg], 'GRID_ROWS')),
        ') ON CONFLICT (lms_station_id) DO UPDATE SET ',
            'name         = EXCLUDED.name, ',
            'base_url     = EXCLUDED.base_url, ',
            'bearer_token = EXCLUDED.bearer_token, ',
            'grid_cols    = EXCLUDED.grid_cols, ',
            'grid_rows    = EXCLUDED.grid_rows, ',
            'cm_updated_when = now()'
    ))

    // Look up the DB pk so callers can reference penguin_order.station_id etc.
    set('pk', null())
    iterate iterator.ofEntity(
        entities: < <@iterator/entity name: 's', entity: 'penguin/station',
                                       where:   concat('lms_station_id=', pb.get([cfg], 'ID'))> >,
        rows: 1
    )
        set('pk', bo.attr([s], 'id'))
        exit
    end-iterate

    return <
        ID:             [pk],
        LMS_STATION_ID: pb.get([cfg], 'ID'),
        NAME:           pb.get([cfg], 'NAME'),
        BASE_URL:       pb.get([cfg], 'BASE_URL'),
        BEARER_TOKEN:   pb.get([cfg], 'BEARER_TOKEN'),
        GRID_COLS:      pb.get([cfg], 'GRID_COLS'),
        GRID_ROWS:      pb.get([cfg], 'GRID_ROWS')
    >

end-function
