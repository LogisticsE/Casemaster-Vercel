// Hard-codes the Axylog API credentials so script/axylog/sync.cms can read
// them from one place. In a real deployment these would come from a qualifier
// or be injected via configuration; this keeps the demo self-contained.
function load()
    return <
        AUTH_URL:           'https://api.axylog.com/authentication?v=1',
        AXYLOG_USERNAME:    'bdispa@9knots.co.uk',
        AXYLOG_PASSWORD:    'Gl@shandel1966',
        DELIVERIES_URL:     'https://api.axylog.com/Deliveries?v=2',
        CONTEXT_OWNER:      '1245',
        COMPANY:            '1245',
        USER:               '10277',
        SOURCE_DEVICE_TYPE: '3',
        LANGUAGE_CODE:      'en-US'
    >
end-function
