// Maps to the `customer_visit` Postgres view — visit_in_trip joined with the
// CO/MD attribution rule applied to derive `customer_party_id`.
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'Customer visit',
        table: 'customer_visit',
        primaryKey: 'visit_id',
        deleteRule: deleteRule.NotAllowed,
        auditable: auditing.None,
        attributes: <
            visit_id: <@bo/attribute
                label: 'Visit',
                column: 'visit_id',
                dataType: dataType.Long,
                length: 18,
                optional: false()
            >,
            customer_party_id: <@bo/attribute
                label: 'Customer',
                column: 'customer_party_id',
                dataType: dataType.Long,
                length: 18,
                foreignKey: 'axylog/party'
            >,
            trip_id: <@bo/attribute
                label: 'Trip',
                column: 'trip_id',
                dataType: dataType.Long,
                length: 18,
                foreignKey: 'axylog/trip'
            >,
            type: <@bo/attribute
                label: 'Type',
                column: 'type',
                dataType: dataType.String,
                length: 4,
                caseSensitive: true()    // backed by enum visit_type — see visit.cms note
            >,
            outcome: <@bo/attribute
                label: 'Outcome',
                column: 'outcome',
                dataType: dataType.String,
                length: 20,
                caseSensitive: true()    // backed by enum outcome_status
            >,
            outcome_dt: <@bo/attribute
                label: 'Outcome at',
                column: 'outcome_dt',
                dataType: dataType.Timestamp
            >,
            scheduled_min_dt: <@bo/attribute
                label: 'Scheduled',
                column: 'scheduled_min_dt',
                dataType: dataType.Timestamp
            >,
            planned_eta: <@bo/attribute
                label: 'Planned ETA',
                column: 'planned_eta',
                dataType: dataType.Timestamp
            >,
            eta: <@bo/attribute
                label: 'ETA',
                column: 'eta',
                dataType: dataType.Timestamp
            >,
            arrival_dt: <@bo/attribute
                label: 'Arrived',
                column: 'arrival_dt',
                dataType: dataType.Timestamp
            >,
            doc_number: <@bo/attribute
                label: 'Doc #',
                column: 'doc_number',
                dataType: dataType.String,
                length: 80
            >,
            doc_kind: <@bo/attribute
                label: 'Kind',
                column: 'doc_kind',
                dataType: dataType.String,
                length: 10
            >,
            pending_stops_ahead: <@bo/attribute
                label: 'Stops ahead',
                column: 'pending_stops_ahead',
                dataType: dataType.Long,
                length: 6
            >,
            trip_status: <@bo/attribute
                label: 'Trip status',
                column: 'trip_status',
                dataType: dataType.String,
                length: 30
            >,
            driver_name: <@bo/attribute
                label: 'Driver',
                column: 'driver_name',
                dataType: dataType.String,
                length: 120
            >,
            plate_number: <@bo/attribute
                label: 'Plate',
                column: 'plate_number',
                dataType: dataType.String,
                length: 40
            >,
            visit_party_name: <@bo/attribute
                label: 'Destination',
                column: 'visit_party_name',
                dataType: dataType.String,
                length: 200
            >,
            visit_address: <@bo/attribute
                label: 'Address',
                column: 'visit_address',
                dataType: dataType.String,
                length: 200
            >,
            visit_zip: <@bo/attribute
                label: 'Zip',
                column: 'visit_zip',
                dataType: dataType.String,
                length: 20
            >,
            visit_city: <@bo/attribute
                label: 'City',
                column: 'visit_city',
                dataType: dataType.String,
                length: 80
            >,
            visit_country: <@bo/attribute
                label: 'Country',
                column: 'visit_country',
                dataType: dataType.String,
                length: 50
            >,
            visit_lat: <@bo/attribute
                label: 'Lat',
                column: 'visit_lat',
                dataType: dataType.Decimal,
                length: 10,
                precision: 7
            >,
            visit_lon: <@bo/attribute
                label: 'Lon',
                column: 'visit_lon',
                dataType: dataType.Decimal,
                length: 10,
                precision: 7
            >,
            courier_latlon: <@bo/attribute
                label: 'Courier @',
                column: 'courier_latlon',
                dataType: dataType.String,
                length: 80
            >,
            courier_lat: <@bo/attribute
                label: 'Courier lat',
                column: 'courier_lat',
                dataType: dataType.Decimal,
                length: 10,
                precision: 7
            >,
            courier_lon: <@bo/attribute
                label: 'Courier lon',
                column: 'courier_lon',
                dataType: dataType.Decimal,
                length: 10,
                precision: 7
            >,
            courier_dt: <@bo/attribute
                label: 'Courier seen',
                column: 'courier_dt',
                dataType: dataType.Timestamp
            >
        >,
        attributeGroups: <
            label: < 'doc_number' >,
            list:  <
                'type',
                'doc_kind',
                'doc_number',
                'visit_party_name',
                'visit_city',
                'scheduled_min_dt',
                'outcome',
                'pending_stops_ahead'
            >
        >
    >
end-resource
