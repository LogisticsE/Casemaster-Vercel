// Mirror of one Penguin LMS booking order. Synced from POST /orders {id:0}
// via script/penguin/sync.cms. The compartment "is reserved at time T" check
// is a JOIN against this table + penguin_unit (locker_display_name).
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'Penguin order',
        table: 'penguin_order_v2',
        primaryKey: 'id',
        deleteRule: deleteRule.Allowed,
        auditable: auditing.None,
        attributes: <
            id:              <@bo/attribute label: 'ID',             column: 'id',              dataType: dataType.Long,    length: 18, optional: false()>,
            station_id:      <@bo/attribute label: 'Station',        column: 'locker_station',  dataType: dataType.Long,    length: 18, foreignKey: 'penguin/station'>,
            lms_order_id:    <@bo/attribute label: 'LMS order id',   column: 'lms_order_id',    dataType: dataType.Long,    length: 12>,
            name:            <@bo/attribute label: 'Name',           column: 'name',            dataType: dataType.String,  length: 200>,
            external_id:     <@bo/attribute label: 'External id',    column: 'external_id',     dataType: dataType.String,  length: 200>,
            description:     <@bo/attribute label: 'Description',    column: 'description',     dataType: dataType.String,  length: 1000>,
            end_user:        <@bo/attribute label: 'Account contact', column: 'end_user',       dataType: dataType.Long,    length: 18, foreignKey: 'account/contact'>,
            end_user_id:     <@bo/attribute label: 'LMS user id',    column: 'end_user_lms_id', dataType: dataType.Long,    length: 12>,
            end_user_name:   <@bo/attribute label: 'End user',       column: 'end_user_name',   dataType: dataType.String,  length: 200>,
            end_user_email:  <@bo/attribute label: 'End user email', column: 'end_user_email',  dataType: dataType.String,  length: 200>,
            end_user_phone:  <@bo/attribute label: 'End user phone', column: 'end_user_phone',  dataType: dataType.String,  length: 50>,
            time_begin:      <@bo/attribute label: 'Begin',          column: 'time_begin',      dataType: dataType.Timestamp>,
            time_end:        <@bo/attribute label: 'End',            column: 'time_end',        dataType: dataType.Timestamp>,
            time_picking:    <@bo/attribute label: 'Picking',        column: 'time_picking',    dataType: dataType.Timestamp>,
            prm:             <@bo/attribute label: 'PRM',            column: 'prm',             dataType: dataType.String,  length: 1, caseSensitive: true()>,
            creation_date:   <@bo/attribute label: 'Created',        column: 'creation_date',   dataType: dataType.Timestamp>,
            order_status:    <@bo/attribute label: 'Status',         column: 'order_status',    dataType: dataType.String,  length: 20, caseSensitive: true()>,
            updated_at:      <@bo/attribute label: 'Updated',        column: 'cm_updated_when', dataType: dataType.Timestamp>
        >,
        attributeGroups: <
            label: < 'name' >,
            list:  < 'name', 'external_id', 'end_user_name', 'time_begin', 'time_end', 'order_status' >
        >
    >
end-resource
