// One physical locker door at a station, identified by display_name (e.g.
// "C2 R3"). Discovered lazily as we observe locker.display_name in synced
// orders, or pre-seeded from grid_cols × grid_rows.
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'Locker compartment',
        table: 'rd_locker_compartment',
        primaryKey: 'id',
        deleteRule: deleteRule.Allowed,
        auditable: auditing.None,
        attributes: <
            id:             <@bo/attribute label: 'ID',             column: 'id',             dataType: dataType.Long,    length: 18, optional: false()>,
            station_id:     <@bo/attribute label: 'Station',        column: 'locker_station', dataType: dataType.Long,    length: 18, foreignKey: 'penguin/station'>,
            display_name:   <@bo/attribute label: 'Display name',   column: 'display_name',   dataType: dataType.String,  length: 80, optional: false()>,
            grid_col:       <@bo/attribute label: 'Col',            column: 'grid_col',       dataType: dataType.Long,    length: 4>,
            grid_row:       <@bo/attribute label: 'Row',            column: 'grid_row',       dataType: dataType.Long,    length: 4>,
            out_of_service: <@bo/attribute label: 'Out of service', column: 'out_of_service', dataType: dataType.Boolean>,
            last_seen_at:   <@bo/attribute label: 'Last seen',      column: 'last_seen_at',   dataType: dataType.Timestamp>,
            purpose:        <@bo/attribute label: 'Purpose',        column: 'purpose',        dataType: dataType.String, length: 30, caseSensitive: true()>,
            size:           <@bo/attribute label: 'Size',           column: 'size',           dataType: dataType.String, length: 20, caseSensitive: true()>,
            reusable_color: <@bo/attribute label: 'Reusable color', column: 'reusable_color', dataType: dataType.String, length: 20>,
            cell_span_rows: <@bo/attribute label: 'Span rows',      column: 'cell_span_rows', dataType: dataType.Long,   length: 4>,
            notes:          <@bo/attribute label: 'Notes',          column: 'notes',          dataType: dataType.String, length: 1000>
        >,
        attributeGroups: <
            label: < 'display_name' >,
            list:  < 'display_name', 'grid_col', 'grid_row', 'out_of_service', 'last_seen_at' >
        >
    >
end-resource
