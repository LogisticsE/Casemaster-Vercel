// Flat (unit × order) view of every currently-active locker booking.
// Used by the grid page: filter on a chosen day's window to discover which
// compartments are booked on that day. One row per active unit.
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'Penguin active booking',
        table: 'penguin_active_unit_order',
        primaryKey: 'unit_id',
        deleteRule: deleteRule.NotAllowed,
        auditable: auditing.None,
        attributes: <
            unit_id:        <@bo/attribute label: 'Unit',         column: 'unit_id',        dataType: dataType.Long,    length: 18, optional: false()>,
            display_name:   <@bo/attribute label: 'Locker',       column: 'display_name',   dataType: dataType.String,  length: 80>,
            unit_status:    <@bo/attribute label: 'Unit status',  column: 'unit_status',    dataType: dataType.String,  length: 20>,
            order_id:       <@bo/attribute label: 'Order',        column: 'order_id',       dataType: dataType.Long,    length: 18>,
            station_id:     <@bo/attribute label: 'Station',      column: 'station_id',     dataType: dataType.Long,    length: 18>,
            lms_order_id:   <@bo/attribute label: 'LMS order id', column: 'lms_order_id',   dataType: dataType.Long,    length: 12>,
            external_id:    <@bo/attribute label: 'External id',  column: 'external_id',    dataType: dataType.String,  length: 200>,
            end_user_name:  <@bo/attribute label: 'End user',     column: 'end_user_name',  dataType: dataType.String,  length: 200>,
            time_begin:     <@bo/attribute label: 'Begin',        column: 'time_begin',     dataType: dataType.Timestamp>,
            time_end:       <@bo/attribute label: 'End',          column: 'time_end',       dataType: dataType.Timestamp>,
            order_status:   <@bo/attribute label: 'Order status', column: 'order_status',   dataType: dataType.String,  length: 20>
        >,
        attributeGroups: <
            label: < 'display_name' >,
            list:  < 'display_name', 'end_user_name', 'time_begin', 'time_end', 'order_status' >
        >
    >
end-resource
