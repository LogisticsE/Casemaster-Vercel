// One Penguin LMS station: connection details, grid layout and per-direction
// time-window template (begin/end day-offset + time-of-day for both pickup
// and delivery; picking is optional).
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'Locker station',
        table: 'rd_locker_station',
        primaryKey: 'id',
        deleteRule: deleteRule.NotAllowed,
        auditable: auditing.None,
        attributes: <
            id:                          <@bo/attribute label: 'ID',                       column: 'id',                          dataType: dataType.Long,    length: 18, optional: false()>,
            lms_station_id:              <@bo/attribute label: 'LMS station id',           column: 'lms_station_id',              dataType: dataType.Long,    length: 9,  optional: false()>,
            name:                        <@bo/attribute label: 'Name',                     column: 'name',                        dataType: dataType.String,  length: 200, optional: false()>,
            base_url:                    <@bo/attribute label: 'Base URL',                 column: 'base_url',                    dataType: dataType.String,  length: 500, optional: false()>,
            bearer_token:                <@bo/attribute label: 'Bearer token',             column: 'bearer_token',                dataType: dataType.String,  length: 200, optional: false()>,
            grid_cols:                   <@bo/attribute label: 'Grid cols',                column: 'grid_cols',                   dataType: dataType.Long,    length: 4>,
            grid_rows:                   <@bo/attribute label: 'Grid rows',                column: 'grid_rows',                   dataType: dataType.Long,    length: 4>,
            pickup_begin_day_offset:     <@bo/attribute label: 'Pickup begin day',         column: 'pickup_begin_day_offset',     dataType: dataType.Long,    length: 4>,
            pickup_begin_time:           <@bo/attribute label: 'Pickup begin time',        column: 'pickup_begin_time',           dataType: dataType.String,  length: 8>,
            pickup_end_day_offset:       <@bo/attribute label: 'Pickup end day',           column: 'pickup_end_day_offset',       dataType: dataType.Long,    length: 4>,
            pickup_end_time:             <@bo/attribute label: 'Pickup end time',          column: 'pickup_end_time',             dataType: dataType.String,  length: 8>,
            pickup_picking_day_offset:   <@bo/attribute label: 'Pickup picking day',       column: 'pickup_picking_day_offset',   dataType: dataType.Long,    length: 4>,
            pickup_picking_time:         <@bo/attribute label: 'Pickup picking time',      column: 'pickup_picking_time',         dataType: dataType.String,  length: 8>,
            delivery_begin_day_offset:   <@bo/attribute label: 'Delivery begin day',       column: 'delivery_begin_day_offset',   dataType: dataType.Long,    length: 4>,
            delivery_begin_time:         <@bo/attribute label: 'Delivery begin time',      column: 'delivery_begin_time',         dataType: dataType.String,  length: 8>,
            delivery_end_day_offset:     <@bo/attribute label: 'Delivery end day',         column: 'delivery_end_day_offset',     dataType: dataType.Long,    length: 4>,
            delivery_end_time:           <@bo/attribute label: 'Delivery end time',        column: 'delivery_end_time',           dataType: dataType.String,  length: 8>,
            delivery_picking_day_offset: <@bo/attribute label: 'Delivery picking day',     column: 'delivery_picking_day_offset', dataType: dataType.Long,    length: 4>,
            delivery_picking_time:       <@bo/attribute label: 'Delivery picking time',    column: 'delivery_picking_time',       dataType: dataType.String,  length: 8>,
            notes:                       <@bo/attribute label: 'Notes',                    column: 'notes',                       dataType: dataType.String,  length: 4000>,
            updated_at:                  <@bo/attribute label: 'Updated',                  column: 'cm_updated_when',             dataType: dataType.Timestamp>
        >,
        attributeGroups: <
            label: < 'name' >,
            list:  < 'lms_station_id', 'name', 'grid_cols', 'grid_rows', 'updated_at' >
        >
    >
end-resource
