// Visit — the fact table. One row per delivery (D) or pickup (P) leg.
// Links upward to document and trip. Most attributes are scheduling +
// outcome data; the courier's last GPS position lives here too.
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'Visit',
        table: 'visit',
        primaryKey: 'id',
        deleteRule: deleteRule.Allowed,
        auditable: auditing.None,
        attributes: <
            id: <@bo/attribute
                label: 'ID',
                column: 'id',
                dataType: dataType.Long,
                length: 18,
                optional: false()
            >,
            context_owner_id: <@bo/attribute
                label: 'Context owner',
                column: 'context_owner_id',
                dataType: dataType.Long,
                length: 9,
                foreignKey: 'axylog/contextOwner'
            >,
            document_id: <@bo/attribute
                label: 'Document',
                column: 'document_id',
                dataType: dataType.Long,
                length: 18,
                foreignKey: 'axylog/document',
                optional: false()
            >,
            trip_id: <@bo/attribute
                label: 'Trip',
                column: 'trip_id',
                dataType: dataType.Long,
                length: 18,
                foreignKey: 'axylog/trip'
            >,
            type: <@bo/attribute
                label: 'Type',
                column: 'type',
                dataType: dataType.String,
                length: 4,
                // Underlying column is the Postgres enum `visit_type`, not text.
                // Default String matching wraps both sides in LOWER(); enums
                // don't accept LOWER() so the upsert tryLoad fails with
                //   "function lower(visit_type) does not exist".
                caseSensitive: true()
            >,
            prog: <@bo/attribute
                label: 'Prog',
                column: 'prog',
                dataType: dataType.Long,
                length: 6
            >,
            load_sequence: <@bo/attribute
                label: 'Load seq',
                column: 'load_sequence',
                dataType: dataType.Long,
                length: 6
            >,
            unload_sequence: <@bo/attribute
                label: 'Unload seq',
                column: 'unload_sequence',
                dataType: dataType.Long,
                length: 6
            >,
            scheduled_min_dt: <@bo/attribute
                label: 'Scheduled (min)',
                column: 'scheduled_min_dt',
                dataType: dataType.Timestamp
            >,
            scheduled_max_dt: <@bo/attribute
                label: 'Scheduled (max)',
                column: 'scheduled_max_dt',
                dataType: dataType.Timestamp
            >,
            planned_eta: <@bo/attribute
                label: 'Planned ETA',
                column: 'planned_eta',
                dataType: dataType.Timestamp
            >,
            eta: <@bo/attribute
                label: 'ETA',
                column: 'eta',
                dataType: dataType.Timestamp
            >,
            arrival_dt: <@bo/attribute
                label: 'Arrived',
                column: 'arrival_dt',
                dataType: dataType.Timestamp
            >,
            outcome: <@bo/attribute
                label: 'Outcome',
                column: 'outcome',
                dataType: dataType.String,
                length: 20,
                // Underlying column is enum `outcome_status`. Same LOWER()-on-enum
                // problem as `type` above.
                caseSensitive: true()
            >,
            outcome_dt: <@bo/attribute
                label: 'Outcome at',
                column: 'outcome_dt',
                dataType: dataType.Timestamp
            >,
            outcome_pod_reason: <@bo/attribute
                label: 'POD reason',
                column: 'outcome_pod_reason',
                dataType: dataType.String,
                length: 200
            >,
            outcome_note: <@bo/attribute
                label: 'Outcome note',
                column: 'outcome_note',
                dataType: dataType.String,
                length: 1000
            >,
            last_position_latlon: <@bo/attribute
                label: 'Last position',
                column: 'last_position_latlon',
                dataType: dataType.String,
                length: 80
            >,
            last_position_dt: <@bo/attribute
                label: 'Last position at',
                column: 'last_position_dt',
                dataType: dataType.Timestamp
            >,
            distance_km: <@bo/attribute
                label: 'Distance (km)',
                column: 'distance_km',
                dataType: dataType.Decimal,
                length: 10,
                precision: 2
            >,
            state_label: <@bo/attribute
                label: 'State',
                column: 'state_label',
                dataType: dataType.String,
                length: 80
            >
        >,
        attributeGroups: <
            label: < 'id' >,
            list:  < 'id', 'type', 'prog', 'scheduled_min_dt', 'arrival_dt', 'outcome', 'outcome_dt' >
        >
    >
end-resource
