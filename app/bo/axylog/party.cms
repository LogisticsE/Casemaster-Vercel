// Master data: shipFrom / shipTo / shipper / warehouse / carrier / subCarrier
// targets all collapse here, keyed by (context_owner_id, master_data_code).
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'Party',
        table: 'party',
        primaryKey: 'id',
        deleteRule: deleteRule.Allowed,
        auditable: auditing.None,
        attributes: <
            id: <@bo/attribute
                label: 'ID',
                column: 'id',
                dataType: dataType.Long,
                length: 18,
                optional: false()
            >,
            context_owner_id: <@bo/attribute
                label: 'Context owner',
                column: 'context_owner_id',
                dataType: dataType.Long,
                length: 9,
                foreignKey: 'axylog/contextOwner'
            >,
            master_data_code: <@bo/attribute
                label: 'Master data code',
                column: 'master_data_code',
                dataType: dataType.String,
                length: 80,
                optional: false()
            >,
            company_name: <@bo/attribute
                label: 'Company',
                column: 'company_name',
                dataType: dataType.String,
                length: 200
            >,
            city: <@bo/attribute
                label: 'City',
                column: 'city',
                dataType: dataType.String,
                length: 80
            >,
            country: <@bo/attribute
                label: 'Country',
                column: 'country',
                dataType: dataType.String,
                length: 50
            >,
            address: <@bo/attribute
                label: 'Address',
                column: 'address',
                dataType: dataType.String,
                length: 200
            >,
            zip_code: <@bo/attribute
                label: 'Zip',
                column: 'zip_code',
                dataType: dataType.String,
                length: 20
            >,
            latitude: <@bo/attribute
                label: 'Lat',
                column: 'latitude',
                dataType: dataType.Decimal,
                length: 10,
                precision: 7
            >,
            longitude: <@bo/attribute
                label: 'Lon',
                column: 'longitude',
                dataType: dataType.Decimal,
                length: 10,
                precision: 7
            >
        >,
        attributeGroups: <
            label: < 'company_name' >,
            // 'country' is intentionally absent — Axylog populates it on
            // <0.6% of party rows, so the column always reads as empty in the
            // customer picker. The attribute is still on the BO above so any
            // page that wants it can still call bo.attr([party], 'country')
            // for the rare row where it IS set.
            list:  < 'master_data_code', 'company_name', 'city' >
        >
    >
end-resource
