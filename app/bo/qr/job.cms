// One imported batch (CSV) of codes-to-print. Equivalent of a print job in
// the BarTender world — but stored, searchable, and re-printable.
function main()
    return script.get('./main')
end-function

resource main
    <@bo
        label: 'QR job',
        table: 'qr_job',
        primaryKey: 'id',
        deleteRule: deleteRule.Allowed,
        auditable: auditing.None,
        attributes: <
            id:              <@bo/attribute label: 'ID',              column: 'id',              dataType: dataType.Long,    length: 18, optional: false()>,
            customer:        <@bo/attribute label: 'Customer',        column: 'customer',        dataType: dataType.Long,    length: 18, foreignKey: 'account/account'>,
            name:            <@bo/attribute label: 'Name',            column: 'name',            dataType: dataType.String,  length: 200>,
            source_filename: <@bo/attribute label: 'Source filename', column: 'source_filename', dataType: dataType.String,  length: 260>,
            imported_at:     <@bo/attribute label: 'Imported',        column: 'imported_at',     dataType: dataType.Timestamp>,
            code_count:      <@bo/attribute label: 'Codes',           column: 'code_count',      dataType: dataType.Long,    length: 9>,
            status:          <@bo/attribute label: 'Status',          column: 'status',          dataType: dataType.String,  length: 20>,
            template:        <@bo/attribute label: 'Template',        column: 'template',        dataType: dataType.Long,    length: 18, foreignKey: 'qr/labelTemplate'>,
            source:          <@bo/attribute label: 'Source',          column: 'source',          dataType: dataType.String,  length: 20>,
            notes:           <@bo/attribute label: 'Notes',           column: 'notes',           dataType: dataType.String,  length: 4000>
        >,
        attributeGroups: <
            label: < 'name' >,
            list:  < 'name', 'imported_at', 'code_count', 'status' >
        >
    >
end-resource
