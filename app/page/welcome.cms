// Default landing page for a fresh cms-vercel install.
//
// This file is YOURS to edit. It lives in app/, which is the user code
// boundary — anything outside app/ is the runtime framework and shouldn't
// be edited (you'll lose changes when you `git pull` for an update).
//
// Routing: the function name `welcome` becomes the URL `/page/welcome/f/welcome`.
// The vercel.json rewrites map `/` to this function so the project root
// shows this page out of the box.

function welcome()
    set('main', page.get('./welcomeBody'))
    page.render(page.get('./welcomeShell'))
end-function

protected resource welcomeBody
    <@page/container
        content: <@page/content
            title: <@page/title label: 'cms-vercel'>,
            content: <@page/html resolveTemplate(
                `<p class="lead">
                    A serverless runtime that lets
                    <a href="https://docs.casemaster.io/">CaseMaster</a>
                    <code>.cms</code> applications deploy to
                    <a href="https://vercel.com/">Vercel</a> — same source,
                    same Postgres, same URLs. No long-running .NET host,
                    no Windows-only binaries.
                </p>

                <p>
                    <span class="pill">starter app</span>
                    <span class="pill pill-warn">edit me in <code>app/page/welcome.cms</code></span>
                </p>

                <h2>Where to put your code</h2>
                <ul>
                    <li><code>app/bo/</code> — Business Object declarations (auto-CRUD at <code>/maintenance/&lt;bo&gt;</code>)</li>
                    <li><code>app/page/</code> — page handler functions (URL: <code>/page/&lt;script&gt;/f/&lt;function&gt;</code>)</li>
                    <li><code>app/script/</code> — reusable functions, no URL of their own</li>
                    <li><code>app/qualifier/</code> — custom <code>&lt;@&gt;</code> qualifiers</li>
                </ul>
                <p>
                    Don't edit anything in <code>packages/runtime/</code> — that's
                    the framework. <code>git pull</code> for updates.
                </p>

                <h2>Live demos on this deployment</h2>
                <div class="row">
                    <div class="card">
                        <a href="/page/welcome/f/welcome">This page</a>
                        <p>You're looking at it. Rendered by cms-vercel through
                           <code>&lt;@page/container&gt;</code> +
                           <code>resolveTemplate</code>, with CSS from
                           <code>/static/</code>.</p>
                    </div>
                    <div class="card">
                        <a href="/page/ping/f/ping">DB connectivity</a>
                        <p>Hits Postgres' <code>information_schema.tables</code>
                           through <code>sql.fetch</code> + an
                           <code>iterate</code> loop. Returns <code>ok N</code>.</p>
                    </div>
                    <div class="card">
                        <a href="/api?stats=1">Runtime stats</a>
                        <p>JSON probe — registry warmth, function/resource/BO
                           counts, cold-vs-warm-start signal.</p>
                    </div>
                </div>
                <p style="color:#64748b;font-size:13px;margin-top:0.6rem">
                    The auto-CRUD demo (<code>/maintenance/&lt;bo&gt;</code>)
                    needs at least one <code>&lt;@bo&gt;</code> declaration
                    in <code>app/bo/</code>. This starter ships zero so the
                    demo stays free of project data — drop a single BO file
                    in and the maintenance UI appears with no other code change.
                </p>

                <h2>Next steps</h2>
                <ol>
                    <li>Edit <code>app/page/welcome.cms</code> to make this page yours.</li>
                    <li>Read <a href="https://github.com/LadFoxTom/Casemaster-Vercel/blob/main/BUILDING.md">BUILDING.md</a>
                        to add your first BO + page.</li>
                    <li>Or read <a href="https://github.com/LadFoxTom/Casemaster-Vercel/blob/main/CONVERTING.md">CONVERTING.md</a>
                        if you're porting an existing CaseMaster app — point
                        <code>node packages/runtime/bin/import.mjs</code>
                        at your <code>casemaster-runtime/</code>.</li>
                    <li><code>git push</code> deploys to Vercel. See
                        <a href="https://github.com/LadFoxTom/Casemaster-Vercel/blob/main/HOWTOLAUNCH.md">HOWTOLAUNCH.md</a>
                        for the deploy walkthrough.</li>
                </ol>

                <p class="meta">
                    Source:
                    <a href="https://github.com/LadFoxTom/Casemaster-Vercel">github.com/LadFoxTom/Casemaster-Vercel</a>
                    · Diagnostics:
                    <a href="/api?diag=1">/api?diag=1</a>
                </p>`
            )>
        >
    >
end-resource

protected resource welcomeShell
    <@page/html resolveTemplate(
        `<!doctype html>
        <html lang="en">
        <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <title>cms-vercel — CaseMaster on Vercel</title>
            <link rel="stylesheet" href="/static/css/app.css">
            <style>
                .container       { max-width: 820px; }
                h1               { font-size: 2rem; letter-spacing: -0.02em; }
                h2               { margin-top: 2.2rem; font-size: 1.1rem; color: #475569;
                                   font-weight: 600; text-transform: uppercase;
                                   letter-spacing: 0.06em; font-size: 12px; }
                p, li            { color: #1f2937; line-height: 1.6; }
                .lead            { font-size: 1.05rem; color: #475569; }
                code             { background: #eef2f6; padding: 1px 6px; border-radius: 3px;
                                   font-size: 13px; color: #0f172a; }
                .pill            { display: inline-block; padding: 2px 8px; border-radius: 999px;
                                   font-size: 11px; background: #dcfce7; color: #166534;
                                   font-weight: 600; }
                .pill-warn       { background: #fef3c7; color: #92400e; }
                .row             { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 0.8rem; }
                .card            { flex: 1 1 220px; padding: 14px 16px; background: #f8fafc;
                                   border: 1px solid #e1e8ed; border-radius: 8px; }
                .card a          { font-weight: 600; }
                .meta            { color: #94a3b8; font-size: 12px; margin-top: 2.4rem;
                                   padding-top: 1rem; border-top: 1px solid #e1e8ed; }
                a                { color: #2563eb; }
                a:hover          { text-decoration: underline; }
            </style>
        </head>
        <body>
            {{[main]}}
        </body>
        </html>`
    )>
end-resource
